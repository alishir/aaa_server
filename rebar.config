{erl_opts, [debug_info, warn_export_all, warn_unused_import, warn_unused_vars]}.

{deps, [
  {cowboy, "2.10.0"},
  {jsx,    "3.1.0"},
  {eredis, "1.7.1"}
]}.

%% Compile Diameter .dia dictionary sources in priv/dict/ into
%% .erl/.hrl in apps/aaa_server/src/ before normal Erlang compilation.
%% Uses diameter_make from OTP — no external plugin required.
{pre_hooks, [
  {compile, "./scripts/compile-diameter-dicts.sh"}
]}.

{relx, [
  {release, {aaa_server, "0.1.24"}, [aaa_server, diameter, sasl]},
  {dev_mode, true},
  {include_erts, false}
]}.

{profiles, [
  {prod, [{relx, [{dev_mode, false}, {include_erts, true}]}]},
  {test, [
    {erl_opts, [debug_info, nowarn_export_all]},
    {extra_src_dirs, [{"test", [{recursive, true}]}]}
  ]}
]}.

%% Common Test configuration
{ct_opts, [
  {sys_config, "./sys.config"},
  {logdir, "./_build/test/logs"}
]}.

{cover_enabled, true}.

%% `rebar3 test` -> compile, run all eunit tests and CT suites
{alias, [{test, [compile, eunit, ct]}]}.
